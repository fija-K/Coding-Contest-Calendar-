# Coding Contest Calendar Environment Configuration

PROJECT_NAME=Coding Contest Calendar
API_V1_STR=/api/v1
DATABASE_URL=sqlite:///./contests.db

# Admin API Key for triggering manual refreshes
ADMIN_API_KEY=dev-admin-secret-key-change-in-prod

# Refresh interval in minutes
REFRESH_INTERVAL_MINUTES=30
HTTP_TIMEOUT_SECONDS=15
MAX_RETRIES=3

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://localhost:8000"]

# Upstream Source Endpoints
CODEFORCES_API_URL=https://codeforces.com/api/contest.list?gym=false
CODECHEF_API_URL=https://www.codechef.com/api/list/contests/all?sort_by=START&sorting_order=asc&offset=0&mode=all
LEETCODE_GRAPHQL_URL=https://leetcode.com/graphql
